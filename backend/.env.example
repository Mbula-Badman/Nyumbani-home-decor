APP_ENV=development
# Replace choose_a_password with your nyumbani_user password.
DATABASE_URL=sqlite:///./nyumbani.db
# Neon: replace the SQLite URL with the connection string copied from the Neon Console.
# Keep sslmode=require (and channel_binding=require, if included).
# Example only: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Optional direct (non-pooled) Neon URL for Alembic migrations; blank uses DATABASE_URL.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Email address of the first administrator; only this configured account receives admin access.
ADMIN_EMAIL=

# ---------- M-Pesa (Safaricom Daraja) ----------
# Keep these credentials private in backend/.env. Never put them in frontend code.
MPESA_ENV=sandbox
# Paste the sandbox app's Consumer Key from the Daraja developer portal.
MPESA_CONSUMER_KEY=
# Paste the matching sandbox Consumer Secret.
MPESA_CONSUMER_SECRET=
# Paste the sandbox Lipa Na M-Pesa Online Passkey (not the Consumer Secret).
MPESA_PASSKEY=
# Set the Daraja sandbox Business Short Code supplied for your sandbox app.
MPESA_SHORTCODE=
# Set the receiving PartyB from the Daraja sandbox details. For Paybill this is usually the shortcode;
# for Buy Goods use the sandbox Till number. Leave blank to use MPESA_SHORTCODE.
MPESA_PARTY_B=
# Paybill: CustomerPayBillOnline. Buy Goods/Till: CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS callback URL ending in /api/mpesa/callback (e.g. your ngrok HTTPS URL).
MPESA_CALLBACK_URL=
