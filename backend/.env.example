APP_ENV=development
# Replace choose_a_password with your nyumbani_user password.
DATABASE_URL=sqlite:///./nyumbani.db
# Neon: replace the SQLite URL with the connection string copied from the Neon Console.
# Keep sslmode=require (and channel_binding=require, if included).
# Example only: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Optional direct (non-pooled) Neon URL for Alembic migrations; blank uses DATABASE_URL.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Email address of the first administrator; only this configured account receives admin access.
ADMIN_EMAIL=

# ---------- M-Pesa (Safaricom Daraja) ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# TODO (CLIENT): put the client's Till Number or Paybill Number here.
# While testing in sandbox, use Safaricom's sandbox shortcode instead.
MPESA_SHORTCODE=

# TODO (CLIENT): set this to match what the client has:
#   Till Number -> CustomerBuyGoodsOnline
#   Paybill     -> CustomerPayBillOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Must be a public HTTPS URL (use a tunnel such as ngrok while developing).
MPESA_CALLBACK_URL=
